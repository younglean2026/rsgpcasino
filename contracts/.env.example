# Chave privada de uma carteira NOVA só pra deploy (nunca a sua carteira principal)
PRIVATE_KEY=0xSUA_CHAVE_PRIVADA

# RPCs (os públicos funcionam; Alchemy/QuickNode são mais estáveis)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Opcional: verificação do código no Basescan (chave da etherscan.io serve)
ETHERSCAN_API_KEY=

# Opcional
CALLBACK_GAS_LIMIT=50000
MIN_BET=100
# TEST_TOKEN=0x... (só na testnet; se vazio, o script cria um RSGP de teste)
